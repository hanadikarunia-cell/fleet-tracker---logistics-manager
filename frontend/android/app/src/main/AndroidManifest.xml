<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The tracker page (reachable from this app's chooser screen) calls the standard
         Geolocation Web API directly on the web — Capacitor's WebView bridge handles the
         runtime permission prompt for it, but only once these are declared. On Android,
         tracking instead goes through @capacitor-community/background-geolocation (see
         TrackerPage.tsx) so it keeps running with the screen off; these two permissions
         still cover the initial foreground fix either way. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Background location tracking (@capacitor-community/background-geolocation). The
         plugin's own manifest declares the <service> and most of these, but they're
         listed here explicitly too so the requirement is visible in this repo rather than
         buried in a dependency, and so a manifest-merge quirk can't silently drop one. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+ requires this to show the "tracking active" notification the
         foreground service is required to display; requested at runtime via
         @capacitor/local-notifications when tracking starts (see TrackerPage.tsx). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- In-app update (UpdateInstaller.java): lets the app ask the user to allow it to
         install an APK it downloaded itself. Declaring this does NOT grant it — Android
         still makes the user flip it on once, per app, in its own Settings screen
         (ACTION_MANAGE_UNKNOWN_APP_SOURCES), and still shows its own install-confirmation
         dialog every time. Neither of those can be skipped from here; this permission just
         makes it possible to ask. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
